rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TESTING MODE: Allow authenticated writes and public reads
    
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Albums collection
    match /albums/{albumId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      // Photos subcollection
      match /photos/{photoId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    
    // Allow collectionGroup queries on photos
    match /{path=**}/photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
