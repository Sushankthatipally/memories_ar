# Environment Configuration Template
# Copy this to .env (not tracked by git)

# Project Information
PROJECT_NAME=AR Admin Dashboard
PROJECT_VERSION=1.0.0

# Firebase Project
# Get these from Firebase Console > Project Settings
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Admin Credentials (Initial Setup)
# Create these in Firebase Console > Authentication
ADMIN_EMAIL=admin@yourstudio.com
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# Deployment
HOSTING_URL=https://your-project.web.app
CUSTOM_DOMAIN=admin.yourstudio.com

# Storage Configuration
STORAGE_MAX_FILE_SIZE_MB=100
ALLOWED_IMAGE_TYPES=jpg,jpeg,png
ALLOWED_VIDEO_TYPES=mp4,mov

# Feature Flags
ENABLE_CLOUD_FUNCTIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=true

# Development
DEBUG_MODE=false
USE_EMULATOR=false
EMULATOR_HOST=localhost
EMULATOR_AUTH_PORT=9099
EMULATOR_FIRESTORE_PORT=8080
EMULATOR_STORAGE_PORT=9199
EMULATOR_FUNCTIONS_PORT=5001

# Notes:
# 1. Never commit this file to version control
# 2. Add .env to .gitignore
# 3. Share template only, not actual values
# 4. Rotate credentials regularly for production
